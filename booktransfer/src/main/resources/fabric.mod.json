			"com.ambik1.booktransfer.compat.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		"booktransfer.mixins.json"
	],
	"suggests": {
		"modmenu": "*"
